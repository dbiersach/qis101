# Standardize line endings across every machine that touches this
# repository. Text files are stored and checked out with LF, so notebooks
# and scripts never show phantom CRLF diffs. It matters most for the shell
# installer: a CRLF shebang line breaks execution on Linux with a
# misleading "bad interpreter" error.
* text=auto eol=lf

# Python sources and notebooks. The diff=python driver makes `git diff`
# show the enclosing function in the hunk header instead of a bare line
# number.
*.py    text eol=lf diff=python

# Notebooks additionally run through the nb_clean filter, which strips the
# interpreter version and the per-cell execution timestamps that Jupyter
# rewrites on every save. Without it those fields produce a diff on files
# nobody edited. Git will not run a filter a clone has not registered, so
# enable it once per clone:
#
#   git config filter.nbclean.clean "uv run --quiet --no-project python nb_clean.py"
#
# nb_clean.py imports only the standard library, so
# `git config filter.nbclean.clean "python3 nb_clean.py"` works too and keeps
# uv out of the path.
#
# Skipping that step is harmless: notebooks are then staged verbatim.
#
# A checked-out notebook is smaller than the file Jupyter later writes back,
# because the filter took those fields out of the blob. Git caches the size it
# checked out and, when the file on disk no longer matches it, reports the
# notebook modified WITHOUT running the filter to check. The notebook then
# stays modified forever even though its cleaned bytes equal HEAD. It is not a
# broken filter. Clear it with `git add --renormalize .`, which restages
# nothing because the blob is unchanged. See the "Notebooks that will not stop
# showing as modified" section of AGENTS.md.
*.ipynb text eol=lf filter=nbclean

# Shell scripts must be LF or Linux refuses to run them.
*.sh text eol=lf

# The git hooks carry no extension for `text=auto` to key on, and a CRLF
# shebang line breaks them with a misleading "bad interpreter" error.
githooks/* text eol=lf

# PowerShell reads LF fine on both Windows PowerShell and PowerShell 7.
*.ps1 text eol=lf

# Windows batch files are the one exception: cmd.exe mis-parses labels and
# multi-line blocks when the file uses LF, so force CRLF on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf

# Project configuration.
*.code-workspace text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.lock text eol=lf

# Documentation and data.
*.md  text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Circuit files written by the Digital logic simulator are XML.
*.dig text eol=lf

# Dotfiles that carry no extension for `text=auto` to key on.
.gitignore      text eol=lf
.gitattributes  text eol=lf
.python-version text eol=lf

# Binary assets. Never run line-ending or diff conversion on these.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.pptx    binary
*.docx    binary
*.zip     binary
*.gz      binary
*.wav     binary
*.mp3     binary
*.ttf     binary
*.otf     binary
*.npy     binary
*.npz     binary
*.parquet binary
*.joblib  binary

# Collapse the generated lockfile in GitHub diffs and exclude it from the
# repository language statistics.
uv.lock linguist-generated=true
